# Linux, Apache, PHP (LA-P stack)
FROM php:8-apache

# install
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y mc vim less && \
    pecl install xdebug && docker-php-ext-enable xdebug && \
    docker-php-ext-install pdo pdo_mysql mysqli

# xdebug configuration
RUN echo "xdebug.mode=debug" >> /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini && \
    echo "xdebug.idekey=docker" >> /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini && \
    echo "xdebug.start_with_request=yes" >> /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini && \
    echo "xdebug.client_host=xdebug://gateway" >> /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini && \
    echo "xdebug.client_port=9003" >> /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini

# create user pri/pwd, not to run as root
RUN useradd -m -G www-data -s /bin/bash pri && \
    echo 'pri:pwd' | chpasswd && \
    chmod 755 /home/pri && \
    echo "PS1='\[\033[01;31m\]\W\[\033[00m\] '" >> /root/.bashrc && \
    echo "PS1='\[\033[01;34m\]\W\[\033[00m\] '" >> /home/pri/.bashrc

# Apache configuration
RUN mv /etc/apache2/apache2.conf /etc/apache2/apache2.conf.bak && \
    mv /etc/apache2/sites-available/000-default.conf /etc/apache2/sites-available/000-default.conf.bak
COPY docker/apache2.conf /etc/apache2/
COPY docker/000-default.conf /etc/apache2/sites-available/
RUN a2enmod rewrite headers

# home directory
WORKDIR /home/pri
